# Application Config
PORT=8002
NODE_ENV=development

# SQLite Database Connection via Prisma
DATABASE_URL="file:./database.db"

# Storage Directories
UPLOAD_DIR="uploads"
VIDEO_DIR="video"
PDF_DIR="pdf"

# Upload Limits (Bytes)
MAX_VIDEO_BYTES=209715200
MAX_PDF_BYTES=209715200

# Auth & Security
JWT_SECRET="super-secret-enterprise-key-change-in-production"
